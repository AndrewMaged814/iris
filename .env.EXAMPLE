# Copy into the Iris profile's .env on the Hermes host. Never commit real values.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=        # the owner's numeric Telegram ID (only they can talk to Iris)

# Catalog/cost/aggregate-stock reads need read_products. Offer analysis needs read_discounts;
# creation needs write_discounts (includes reads). See docs/SETUP.md before enabling.
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=             # Dev Dashboard app installed on this store (client credentials grant)
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ADMIN_TOKEN=         # alternative: a static Admin API token instead of the two lines above
SHOPIFY_API_VERSION=2026-07
IRIS_ENABLE_OFFERS=0          # 1 enables native owner-confirmed offer changes; cron/CLI still cannot write
