# Copy into the Iris profile's .env on the Hermes host. Never commit real values.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=        # the owner's numeric Telegram ID (only they can talk to Iris)

# Catalog/cost/aggregate-stock reads need read_products. Offer analysis needs read_discounts;
# creation needs write_discounts (includes reads). See docs/SETUP.md before enabling.
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=             # Dev Dashboard app installed on this store (client credentials grant)
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ADMIN_TOKEN=         # alternative: a static Admin API token instead of the two lines above
SHOPIFY_API_VERSION=2026-07
IRIS_ENABLE_OFFERS=0          # 1 enables native owner-confirmed offer changes; cron/CLI still cannot write

# Competitor search (free, self-hosted SearXNG with the JSON format enabled; see docs/SETUP.md)
SEARXNG_URL=http://127.0.0.1:8888

# Browser for JavaScript-only stores: Hermes's local Chromium with Iris's honest user agent.
# On a root or Docker host, prepend --no-sandbox,--disable-dev-shm-usage, (comma-separated).
AGENT_BROWSER_ARGS="--user-agent=IrisBot/1.0 (market watch for a store owner; read-only)"

# Daily product-page monitoring (free, self-hosted changedetection.io; API key from its Settings → API)
# Leave empty to keep Iris's own daily product-page reads.
CHANGEDETECTION_URL=
CHANGEDETECTION_API_KEY=
