# Copy into the Iris profile's .env on the Hermes host. Never commit real values.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=        # the owner's numeric Telegram ID (only they can talk to Iris)
TELEGRAM_ALLOW_ALL_USERS=false

# App connections use Hermes native Composio OAuth; no Shopify credentials or Composio API key.

# Configure research with Hermes's native web provider setup (`hermes -p iris tools`).
# Use the same working provider as your default profile; no Iris-specific search service.

# Optional native Hermes observability. Configure through `hermes -p iris tools`.
# Put actual keys only in the host profile; capture mode must also be set in the gateway's
# process environment on the pinned Hermes version (see docs/OBSERVABILITY.md).
HERMES_LANGFUSE_PUBLIC_KEY=
HERMES_LANGFUSE_SECRET_KEY=
HERMES_LANGFUSE_BASE_URL=https://cloud.langfuse.com
HERMES_LANGFUSE_CAPTURE=metadata

# Browser for JavaScript-only stores: Hermes's local Chromium with Iris's honest user agent.
# On a root or Docker host, prepend --no-sandbox,--disable-dev-shm-usage, (comma-separated).
AGENT_BROWSER_ARGS="--user-agent=IrisBot/1.0 (market watch for a store owner; read-only)"
